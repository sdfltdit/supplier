# Copy this file to .env for local testing. In production (Render), set
# these as actual environment variables in the dashboard — never commit
# a real .env file to this repo.

TURSO_DATABASE_URL=libsql://supplier-sdfltdit.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_ADDRESS=supplier@sdfltd.com
RESEND_REPLY_TO_ADDRESS=contact@sdfltd.com
SUPPLIER_NOTIFY_EMAIL=contact@sdfltd.com

ALLOWED_ORIGIN=https://supplier.sdfltd.com

# Placeholder admin auth for the internal search endpoint.
# [VERIFY] Replace with something stronger before real use — see the
# security note in src/server.js above the /api/admin/suppliers route.
ADMIN_API_KEY=change-me-to-a-long-random-string

PORT=3000
